{
  "name": "d3-thematika",
  "version": "0.0.1",
  "type": "module",
  "main": "rollup_config.js",
  "directories": {
    "example": "site"
  },
  "scripts": {
    "build": "rollup -c",
    "build:watch": "rollup -c -w",
    "dev": "rollup -c -w",
    "deploy": "gh-pages -d site -m 'Deploy site'"
  },
  "author": "shimizu",
  "license": "ISC",
  "description": "D3.jsベースの静的主題図作成ライブラリ - レイヤーベース設計で美しい地図を簡単に作成",
  "keywords": [
    "d3",
    "d3js",
    "map",
    "thematic-map",
    "visualization",
    "geojson",
    "svg",
    "cartography",
    "choropleth",
    "layer-based"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shimizu/d3-thematika.git"
  },
  "bugs": {
    "url": "https://github.com/shimizu/d3-thematika/issues"
  },
  "homepage": "https://github.com/shimizu/d3-thematika#readme",
  "engines": {
    "node": ">=16.0.0"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "d3-contour": "^4.0.2",
    "d3-delaunay": "^6.0.4",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-geo": "^3.1.1",
    "d3-geo-projection": "^4.0.0",
    "d3-path": "^3.1.0",
    "d3-polygon": "^3.0.1",
    "d3-scale": "^4.0.2",
    "d3-scale-chromatic": "^3.1.0",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "textures": "^1.2.3"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/d3-contour": "^3.0.6",
    "@types/d3-delaunay": "^6.0.4",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-force": "^3.0.10",
    "@types/d3-geo": "^3.1.0",
    "@types/d3-path": "^3.1.1",
    "@types/d3-polygon": "^3.0.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-scale-chromatic": "^3.1.0",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-shape": "^3.1.8",
    "@types/geojson": "^7946.0.16",
    "gh-pages": "^6.3.0",
    "rollup": "^4.60.1",
    "rollup-plugin-livereload": "^2.0.5",
    "rollup-plugin-serve": "^3.0.0",
    "serve": "^14.2.6",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.18",
    "typescript": "^6.0.2"
  }
}
